---

import TerminalLine from './TerminalLine.astro';
import TerminalHeader from './TerminalHeader.astro';
import DefaultText from './DefaultText.astro';

import TerminalInput from '../../react/TerminalInput';

---

<div 
  id="terminal-window"
  class="overflow-hidden flex flex-col fixed top-0 left-0 right-0 bottom-0 m-auto bg-[#000000b0] backdrop-blur-md text-white rounded-lg font-mono text-sm w-3/4 max-w-full h-3/4 max-h-full whitespace-nowrap"
>
  <TerminalHeader />
  <div class="overflow-scroll p-2 leading-4 grow">
    <TerminalLine>whoami</TerminalLine>
    cosmin@senior-frontend-engineer.bucharest
    <TerminalLine>neofetch</TerminalLine>
    <DefaultText />
    <TerminalInput client:load />
  </div>
</div>

<script>

function focusTerminalInput() {
  const terminalInput = document.querySelector('#terminal-input') as HTMLInputElement;
  if (terminalInput) {
    terminalInput?.focus();
  }
}

const terminalWindow = document.querySelector('#terminal-window');
terminalWindow?.addEventListener('click', focusTerminalInput);

</script>

<style>

::-webkit-scrollbar {
  width: 12px;
  height: 12px;
  background-color: rgba(0, 0, 0, 0.05);
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(to right, #acacac, #8e8e8e);
  border: 2px solid transparent;
  background-clip: padding-box;
  border-radius: 10px;
  
  box-shadow: inset 1px 1px 0px rgba(255, 255, 255, 0.4), 
              inset -1px -1px 0px rgba(0, 0, 0, 0.1);
}

::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(to right, #969696, #7a7a7a);
}

::-webkit-scrollbar-corner {
  background: transparent;
}

</style>
