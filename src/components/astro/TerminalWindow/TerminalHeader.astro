---

import TerminalSize from '../../react/TerminalSize.tsx';

// todo make stick to top on horizontal and vertical scroll

---

<div class="
  sticky top-0 z-20 flex items-center h-[24px] px-2
  bg-gradient-to-b from-[#E8E8E8] via-[#B9B9B9] to-[#9B9B9B]
  border-b border-[#515151] rounded-t-[6px]
  shadow-[inset_0_1px_0_rgba(255,255,255,0.4)]
  select-none
">
  <div class="group flex space-x-[8px] items-center w-24">
    <div 
      class="terminal-button relative w-[12px] h-[12px] rounded-full border border-[#9A221C] bg-[#FF5F57] shadow-[inset_0_1px_1px_rgba(0,0,0,0.3)] flex items-center justify-center overflow-hidden after:content-[''] after:absolute after:top-[1px] after:left-[2px] after:w-[7px] after:h-[3px] after:bg-white/30 after:rounded-full active:brightness-90"
    >
      <span class="opacity-0 group-hover:opacity-100 text-[10px] text-[#4c0000] font-bold leading-[0] mt-[-0.5px]">×</span>
    </div>

    <div 
      class="terminal-button relative w-[12px] h-[12px] rounded-full border border-[#A47F15] bg-[#FFBD2E] shadow-[inset_0_1px_1px_rgba(0,0,0,0.3)] flex items-center justify-center overflow-hidden after:content-[''] after:absolute after:top-[1px] after:left-[2px] after:w-[7px] after:h-[3px] after:bg-white/30 after:rounded-full active:brightness-90"
    >
      <span class="opacity-0 group-hover:opacity-100 text-[14px] text-[#5e3e00] font-bold leading-[0] mt-[-1.5px]">−</span>
    </div>

    <div 
      class="terminal-button relative w-[12px] h-[12px] rounded-full border border-[#127F23] bg-[#27C93F] shadow-[inset_0_1px_1px_rgba(0,0,0,0.3)] flex items-center justify-center overflow-hidden after:content-[''] after:absolute after:top-[1px] after:left-[2px] after:w-[7px] after:h-[3px] after:bg-white/30 after:rounded-full active:brightness-90"
    >
      <span class="opacity-0 group-hover:opacity-100 text-[9px] text-[#063b00] font-bold leading-[0]">+</span>
    </div>
  </div>

  <div class="flex-1 text-center">
    <span class="
      text-[11px] font-sans font-bold text-[#3C3C3C] 
      [text-shadow:0_1px_0_rgba(255,255,255,0.4)]
      tracking-tight
    ">
      bash - <TerminalSize client:idle />
    </span>
  </div>

  <div class="w-24"></div>
</div>

<script>

function onButtonClick() {
  alert('Now why would you want to do that?');
}

const buttons = document.querySelectorAll('.terminal-button');
buttons.forEach(button => {
  button.addEventListener('click', onButtonClick);
});

</script>

<style>
  span {
    font-family: "Lucida Grande", "Segoe UI", sans-serif;
  }
</style>
