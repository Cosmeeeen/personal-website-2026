--- 
const cvData = [
  { label: 'Role', value: 'Senior Frontend Engineer' },
  { label: 'Company', value: '8x8' },
  { label: 'Stack', value: 'React, TypeScript, Next.js' },
  { label: 'Experience', value: '4.5+ Years (since Jul 2021)' },
  { label: 'Accessibility', value: 'WCAG 2.2, ARIA, Screen Readers' },
  { label: 'Certification', value: 'IAAP CPACC (Jan 2026)' },
  { label: 'Philosophy', value: 'Universal Design & High Performance' },
  { label: 'Location', value: 'Bucharest, Romania' },
  { label: 'Education', value: 'UniBuc (CS) / UBB (Math-CS)' },
  { label: 'Expertise', value: 'Inclusive UI Engineering' }
];

const maxLineLength = Math.max(...cvData.map(({ label, value }) => `${label}: ${value}`.length));

const getRandomColor = () => {
  const h = Math.floor(Math.random() * 360);
  return `hsl(${h}, 70%, 70%)`;
};

